<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DEMO 09: Dynamic HLS Live TV</title>
  <link rel="stylesheet" href="style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="cinema-bg"></div>
  
  <div class="app-container">
    <!-- Header -->
    <header class="cinema-header">
      <div class="brand">
        <div>
          <h1>GHttpsIOCP Continuous Cinema Live TV</h1>
          <p class="subtitle">DEMO 09: Dynamic HLS Live Broadcast Server (Apple HLS / VLC Compatible)</p>
        </div>
      </div>
      <div class="header-status">
        <div class="listeners-box">
          <span id="activeViewers">0</span> viewers
        </div>
      </div>
    </header>

    <!-- Main Grid -->
    <main class="cinema-grid">
      <!-- Left: Video Screen & Player -->
      <section class="cinema-screen-card">
        <div class="screen-frame">
          <div class="video-container">
            <!-- Professional HLS Video Player -->
            <video id="moviePlayer" playsinline muted autoplay preload="auto">
              Your browser does not support HLS video playback.
            </video>

            <!-- Offline Overlay when server is stopped -->
            <div id="offlineOverlay" class="offline-overlay">
              <div class="offline-box">
                <div class="offline-title">SERVER OFFLINE</div>
                <div class="offline-desc">No active live broadcast from IOCP server. Waiting for broadcast to resume...</div>
              </div>
            </div>
          </div>

          <!-- Player Controls Bar -->
          <div class="player-controls">
            <div class="controls-left">
              <button id="btnStart" class="ctrl-btn ctrl-btn-start" disabled>Start</button>
              <button id="btnPause" class="ctrl-btn ctrl-btn-pause" disabled>Pause</button>
            </div>
            
            <div class="timeline-box">
              <span class="live-indicator">● LIVE</span>
              <span id="sessionTimeDisplay">00:00:00</span>
            </div>

            <div class="controls-right">
              <button id="btnFullscreen" class="ctrl-btn">Fullscreen</button>
            </div>
          </div>
        </div>
      </section>

      <!-- Right: Broadcast Telemetry & Live Monitor -->
      <aside class="cinema-sidebar">
        <!-- Live Telemetry Card -->
        <div class="sidebar-card">
          <div class="card-header">
            <h3>Broadcast Telemetry</h3>
            <span class="badge-mini">PORT 8089</span>
          </div>
          
          <div class="metrics-list">
            <div class="metric-row">
              <span class="m-label">Broadcast Status:</span>
              <span id="streamStateVal" class="m-val highlight-green">LIVE HLS BROADCAST</span>
            </div>
            <div class="metric-row">
              <span class="m-label">Station Uptime:</span>
              <span id="uptimeVal" class="m-val mono">--:--:--</span>
            </div>
            <div class="metric-row">
              <span class="m-label">Your Session Time:</span>
              <span id="userSessionVal" class="m-val mono">00:00:00</span>
            </div>
            <div class="metric-row">
              <span class="m-label">Streaming Protocol:</span>
              <span class="m-val highlight-neon">Apple HLS (stream.m3u8)</span>
            </div>
            <div class="metric-row">
              <span class="m-label">VLC Stream URL:</span>
              <span class="m-val highlight">/live/stream.m3u8</span>
            </div>
            <div class="metric-row">
              <span class="m-label">Stream Duration:</span>
              <span class="m-val mono">Continuous (Infinity)</span>
            </div>
          </div>
        </div>
      </aside>
    </main>
  </div>

  <script src="hls.min.js"></script>
  <script src="app.js?v=hls2"></script>
</body>
</html>
